# Copy to `.env` for local development:  cp .env.example .env
# `.env` is gitignored. Never commit real secret values.

APP_ENV=development
ADMIN_TOKEN=local-admin-token

# DUMMY validation order -- NOT the real expert ranking. It is only here so the server
# runs locally. The organiser sets the real value in the Render dashboard.
#
# Format: a JSON list, best first. Either flat:
#   ["<id>","<id>","<id>","<id>","<id>"]
# or grouped, where an inner list is a tie the expert could not separate:
#   [["<id>"],["<id>","<id>"],["<id>"],["<id>"]]
VALIDATION_EXPERT_RANKING=[["16737"],["16742"],["17191"],["17193"],["20285"]]

SUBMISSION_COOLDOWN_SECONDS=60
MAX_SUBMISSIONS_PER_TEAM=20
DATABASE_URL=sqlite:///./server_data/challenge.db
